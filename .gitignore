.DS_Store
.idea/
.vscode/
.a5c/

# Rust
/target/
**/*.rs.bk

# Apple
apps/apple/.build/
apps/apple/DerivedData/
apps/apple/*.xcodeproj/
apps/apple/Config/*-Info.plist
/swift-generated-sources/

# Android
apps/android/.gradle/
apps/android/**/build/
apps/android/local.properties

# Packaging and validation
.env
artifacts/
coverage/
*.log

# Scratch that lands in the repo root only when a tool redirects TMPDIR here
# (some sandboxed runners do). Never legitimate repository content.
/TemporaryDirectory.*/
/_Users_*.lock
/.tmp*/
/_private_tmp_claude-*.lock
/_tmp_claude-*.lock

# Node compile cache emitted by repo scripts (NODE_COMPILE_CACHE); never repository content
/node-compile-cache/
