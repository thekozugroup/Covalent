<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--
        Personal/debug builds only. The maintained sync engine needs ordinary filesystem paths and
        cannot safely consume Storage Access Framework content URIs. Covalent never opens this
        settings screen except after a user taps the explanation action.
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
</manifest>
