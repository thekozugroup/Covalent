{
	admin off
	persist_config off
	# IP-literal native clients do not send SNI. Select the explicitly configured
	# host certificate for that handshake; client hostname verification still
	# requires the matching DNS/IP SAN and enrolled trust anchor.
	default_sni {$COVALENT_HTTPS_HOST:localhost}
}

# Keep the console independent of the transfer engine. Only these public
# assets are served from disk; all API requests retain node authentication.
(console) {
	@console path / /assets/app.css /assets/app.js /assets/folder-sync-flow.js /assets/pairing-flow.js /assets/tab-flow.js
	handle @console {
		root * /usr/local/share/covalent/web
		header Cache-Control "no-cache"
		file_server
	}
	handle {
		reverse_proxy 127.0.0.1:8787
	}
}

https://{$COVALENT_HTTPS_HOST:localhost}:8443 {
	tls internal
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}
	import console
}

# Optional local ingress for a host TLS proxy such as Tailscale Serve. The
# Unix socket stays inside /config; no cleartext TCP management port is opened.
# Tailscale must still restrict the public side to the private tailnet, and the
# node continues to require its local API token for every mutation.
http:// {
	bind unix//config/covalent-web.sock|0600
	encode zstd gzip
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}
	import console
}
