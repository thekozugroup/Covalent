+func receiveOnlyFileEquals(ffs fs.Filesystem, name, want string) bool {
+	fd, err := ffs.Open(name)
+	if err != nil {
+		return false
+	}
+	defer fd.Close()
+	data, err := io.ReadAll(fd)
+	return err == nil && string(data) == want
+}
