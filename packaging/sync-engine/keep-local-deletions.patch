+
+func (f *folder) covalentCompletionEpoch() uint64 {
+	f.covalentCompletionMut.RLock()
+	epoch := f.covalentEpoch
+	f.covalentCompletionMut.RUnlock()
+	return epoch
+}
+
+func (f *folder) setCovalentCompletion(epoch uint64, completions map[protocol.DeviceID]covalentCompletionPair) bool {
+	f.covalentCompletionMut.Lock()
+	defer f.covalentCompletionMut.Unlock()
+	if f.covalentEpoch != epoch {
+		return false
+	}
+	f.covalentCompletions = completions
+	return true
+}
+
+func (f *folder) covalentCompletion() map[protocol.DeviceID]covalentCompletionPair {
+	if f.Type != config.FolderTypeReceiveOnly {
+		return nil
+	}
+	if f.Paused || f.getHealthErrorWithoutIgnores() != nil {
+		f.clearCovalentCompletion()
+		return nil
+	}
+	f.covalentCompletionMut.RLock()
+	recorded := make(map[protocol.DeviceID]covalentCompletionPair, len(f.covalentCompletions))
+	for device, completion := range f.covalentCompletions {
+		recorded[device] = completion
+	}
+	f.covalentCompletionMut.RUnlock()
+
+	completions := make(map[protocol.DeviceID]covalentCompletionPair, len(recorded))
+	stale := make([]protocol.DeviceID, 0, len(recorded))
+	for device, completion := range recorded {
+		connectionID, indexHandler, active := f.model.covalentPeerIndexState(f.folderID, device)
+		indexID, err := f.db.GetIndexID(f.folderID, device)
+		if active && connectionID == completion.connectionID && indexHandler == completion.indexHandler &&
+			err == nil && indexID == completion.indexID {
+			completions[device] = completion
+		} else {
+			stale = append(stale, device)
+		}
+	}
+	if len(stale) != 0 {
+		f.covalentCompletionMut.Lock()
+		for _, device := range stale {
+			if f.covalentCompletions[device] == recorded[device] {
+				delete(f.covalentCompletions, device)
+			}
+		}
+		f.covalentCompletionMut.Unlock()
+	}
+	return completions
+}
