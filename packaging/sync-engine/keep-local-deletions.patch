+func TestRecvOnlyKeepLocalDeletions(t *testing.T) {
+	m, f, wcfgCancel := setupROFolderWithOptions(t, true, false, false)
+	defer wcfgCancel()
+	defer cleanupModel(m)
+	ffs := f.Filesystem()
+	must(t, ffs.MkdirAll(".stfolder", 0o755))
+	conn := addFakeConn(m, device1, f.ID)
+
+	conn.addFile("exact", 0o644, protocol.FileInfoTypeFile, []byte("one"))
+	conn.addFile("during", 0o644, protocol.FileInfoTypeFile, []byte("during one"))
+	conn.addFile("late", 0o644, protocol.FileInfoTypeFile, []byte("late one"))
+	conn.addFile("tree", 0o755, protocol.FileInfoTypeDirectory, nil)
+	conn.addFile("tree/old", 0o644, protocol.FileInfoTypeFile, []byte("old one"))
+	conn.sendIndexUpdate()
+	pullReceiveOnlyNow(t, f)
+	originalFilesystem := f.mtimefs
+	f.mtimefs = fs.NewFilesystem(fs.FilesystemType("unavailable"), "")
+	keep, err := f.keepLocalDeletion(conn.files[0], make(chan string, 1))
+	f.mtimefs = originalFilesystem
+	if err == nil || keep {
+		t.Fatalf("filesystem error treated as deletion: keep=%v err=%v", keep, err)
+	}
+
+	// Simulate deletion after the queue-time guard, while a temporary update
+	// is ready to install. The finish-time guard must retain the deletion.
+	late, ok, err := m.sdb.GetGlobalFile(f.ID, "late")
+	must(t, err)
+	if !ok {
+		t.Fatal("late remote file is missing")
+	}
+	lateLocal, ok, err := m.sdb.GetDeviceFile(f.ID, protocol.LocalDeviceID, "late")
+	must(t, err)
+	if !ok {
+		t.Fatal("late local file is missing")
+	}
+	lateTemp := fs.TempName("late")
+	writeFilePerm(t, ffs, lateTemp, []byte("late two"), 0o644)
+	must(t, ffs.Remove("late"))
+	dbUpdateChan := make(chan dbUpdateJob, 1)
+	scanChan := make(chan string, 1)
+	kept, err := f.performFinish(late, lateLocal, true, lateTemp, dbUpdateChan, scanChan)
+	must(t, err)
+	if !kept {
+		t.Fatal("finish-time local deletion was not retained")
+	}
+	if _, err := ffs.Lstat("late"); !fs.IsNotExist(err) {
+		t.Fatalf("finish-time guard recreated late: %v", err)
+	}
+	if _, err := ffs.Lstat(lateTemp); !fs.IsNotExist(err) {
+		t.Fatalf("finish-time guard retained temporary file: %v", err)
+	}
+	select {
+	case name := <-scanChan:
+		if name != "late" {
+			t.Fatalf("finish-time guard queued scan for %q", name)
+		}
+	default:
+		t.Fatal("finish-time guard did not queue a scan")
+	}
+	select {
+	case update := <-dbUpdateChan:
+		t.Fatalf("finish-time guard queued database update: %+v", update)
+	default:
+	}
+
+	during, ok, err := m.sdb.GetGlobalFile(f.ID, "during")
+	must(t, err)
+	if !ok {
+		t.Fatal("during remote file is missing")
+	}
+	duringLocal, ok, err := m.sdb.GetDeviceFile(f.ID, protocol.LocalDeviceID, "during")
+	must(t, err)
+	if !ok {
+		t.Fatal("during local file is missing")
+	}
+	duringTemp := fs.TempName("during")
+	writeFilePerm(t, ffs, duringTemp, []byte("during two"), 0o644)
+	removeDuringFinish := &removeOnSecondLstatFilesystem{
+		Filesystem: f.mtimefs,
+		name:       "during",
+	}
+	f.mtimefs = removeDuringFinish
+	kept, err = f.performFinish(during, duringLocal, true, duringTemp, dbUpdateChan, scanChan)
+	f.mtimefs = removeDuringFinish.Filesystem
+	must(t, err)
+	if !kept || removeDuringFinish.calls != 2 {
+		t.Fatalf("concurrent finish deletion was not retained: keep=%v lstatCalls=%d", kept, removeDuringFinish.calls)
+	}
+	if _, err := ffs.Lstat("during"); !fs.IsNotExist(err) {
+		t.Fatalf("finish recreated concurrently deleted file: %v", err)
+	}
+	if _, err := ffs.Lstat(duringTemp); !fs.IsNotExist(err) {
+		t.Fatalf("finish retained concurrent temporary file: %v", err)
+	}
+	select {
+	case name := <-scanChan:
+		if name != "during" {
+			t.Fatalf("concurrent finish guard queued scan for %q", name)
+		}
+	default:
+		t.Fatal("concurrent finish guard did not queue a scan")
+	}
+	must(t, m.ScanFolder(f.ID))
+
+	must(t, ffs.Remove("exact"))
+	must(t, ffs.RemoveAll("tree"))
+
+	// Deliver a newer source version before the local deletion scan. The pull
+	// must defer to that scan instead of recreating either path.
+	conn.updateFile("exact", 0o644, protocol.FileInfoTypeFile, []byte("two"))
+	conn.updateFile("tree/old", 0o644, protocol.FileInfoTypeFile, []byte("old two"))
+	conn.addFile("tree/new", 0o644, protocol.FileInfoTypeFile, []byte("new"))
+	requests := conn.RequestCallCount()
+	conn.sendIndexUpdate()
+	pullReceiveOnlyNow(t, f)
+	must(t, m.ScanFolder(f.ID))
+	pullReceiveOnlyNow(t, f)
+	pullReceiveOnlyNow(t, f)
+
+	for _, name := range []string{"exact", "tree", "tree/old", "tree/new"} {
+		if _, err := ffs.Lstat(name); !fs.IsNotExist(err) {
+			t.Errorf("%s was recreated: %v", name, err)
+		}
+	}
+	if got := conn.RequestCallCount(); got != requests {
+		t.Fatalf("suppressed pulls requested remote blocks: got %d calls, want %d", got, requests)
+	}
+
+	// A later source deletion must not erase the local deletion marker. The
+	// same source path and descendants remain suppressed after recreation.
+	for _, name := range []string{"exact", "tree/old", "tree/new", "tree"} {
+		conn.deleteFile(name)
+	}
+	conn.sendIndexUpdate()
+	pullReceiveOnlyNow(t, f)
+	conn.updateFile("exact", 0o644, protocol.FileInfoTypeFile, []byte("three"))
+	conn.updateFile("tree", 0o755, protocol.FileInfoTypeDirectory, nil)
+	conn.updateFile("tree/old", 0o644, protocol.FileInfoTypeFile, []byte("old three"))
+	conn.updateFile("tree/new", 0o644, protocol.FileInfoTypeFile, []byte("new three"))
+	conn.sendIndexUpdate()
+	pullReceiveOnlyNow(t, f)
+	for _, name := range []string{"exact", "tree", "tree/old", "tree/new"} {
+		if _, err := ffs.Lstat(name); !fs.IsNotExist(err) {
+			t.Errorf("%s was recreated after source delete/recreate: %v", name, err)
+		}
+	}
+
+	f.Revert()
+	pullReceiveOnlyNow(t, f)
+	for name, want := range map[string]string{
+		"exact":    "three",
+		"tree/old": "old three",
+		"tree/new": "new three",
+	} {
+		got := readReceiveOnlyFile(t, ffs, name)
+		if string(got) != want {
+			t.Errorf("%s restored %q, want %q", name, got, want)
+		}
+	}
+}
+
+type removeOnSecondLstatFilesystem struct {
+	fs.Filesystem
+	name  string
+	calls int
+}
+
+func (f *removeOnSecondLstatFilesystem) Lstat(name string) (fs.FileInfo, error) {
+	if name == f.name {
+		f.calls++
+		if f.calls == 2 {
+			if err := f.Filesystem.Remove(name); err != nil {
+				return nil, err
+			}
+		}
+	}
+	return f.Filesystem.Lstat(name)
+}
