+func TestCovalentCompletionTracksPolicyAwarePullAndStatus(t *testing.T) {
+	m, f, wcfgCancel := setupROFolderWithOptions(t, true, false, false)
+	defer wcfgCancel()
+	defer cleanupModel(m)
+	ffs := f.Filesystem()
+	must(t, ffs.MkdirAll(".stfolder", 0o755))
+	conn := addFakeConn(m, device1, f.ID)
+	must(t, m.sdb.SetIndexID(f.ID, device1, covalentTestRemoteIndexID))
+
+	must(t, f.doInSync(func(ctx context.Context) error {
+		conn.addFile("kept", 0o644, protocol.FileInfoTypeFile, []byte("source"))
+		conn.sendIndexUpdate()
+		need, err := m.NeedSize(f.ID, protocol.LocalDeviceID)
+		if err != nil {
+			return err
+		}
+		if need.Files == 0 {
+			return errors.New("pending source file did not produce positive need")
+		}
+		if got := f.covalentCompletion(); len(got) != 0 {
+			return fmt.Errorf("pending file reported completion: %+v", got)
+		}
+		complete, err := f.pull(ctx)
+		if err != nil || !complete {
+			return fmt.Errorf("initial pull failed: complete=%v err=%v", complete, err)
+		}
+		return nil
+	}))
+
+	completion := f.covalentCompletion()[device1]
+	if completion.indexID != covalentTestRemoteIndexID || completion.sequence == 0 {
+		t.Fatalf("initial completion pair is wrong: %+v", completion)
+	}
+
+	must(t, ffs.Remove("kept"))
+	must(t, f.doInSync(func(ctx context.Context) error {
+		if err := f.scanSubdirs(ctx, []string{"kept"}); err != nil {
+			return err
+		}
+		if got := f.covalentCompletion(); len(got) != 0 {
+			return fmt.Errorf("partial scan retained completion: %+v", got)
+		}
+		conn.updateFile("kept", 0o644, protocol.FileInfoTypeFile, []byte("source two"))
+		conn.sendIndexUpdate()
+		need, err := m.NeedSize(f.ID, protocol.LocalDeviceID)
+		if err != nil {
+			return err
+		}
+		if need.Files == 0 {
+			return errors.New("new source version over a kept deletion did not produce positive need")
+		}
+		complete, err := f.pull(ctx)
+		if err != nil || !complete {
+			return fmt.Errorf("policy-aware pull failed: complete=%v err=%v", complete, err)
+		}
+		need, err = m.NeedSize(f.ID, protocol.LocalDeviceID)
+		if err != nil {
+			return err
+		}
+		if need.Files == 0 {
+			return errors.New("policy-aware completion unexpectedly cleared raw need")
+		}
+		if got := f.covalentCompletion()[device1]; got.indexID != covalentTestRemoteIndexID || got.sequence <= completion.sequence {
+			return fmt.Errorf("policy-aware completion pair is wrong: %+v", got)
+		}
+
+		f.setCovalentCompletion(f.covalentCompletionEpoch(), map[protocol.DeviceID]covalentCompletionPair{device1: completion})
+		if err := f.scanSubdirs(ctx, nil); err != nil {
+			return err
+		}
+		if got := f.covalentCompletion(); len(got) != 0 {
+			return fmt.Errorf("full scan retained completion: %+v", got)
+		}
+		return nil
+	}))
+
+	// A newly constructed runner has no completion state even though its
+	// database retains the source index pair.
+	fresh := newReceiveOnlyFolder(m.model, f.ignores, f.FolderConfiguration, nil, events.NoopLogger, f.ioLimiter).(*receiveOnlyFolder)
+	if got := fresh.covalentCompletion(); len(got) != 0 {
+		t.Fatalf("new runner inherited completion: %+v", got)
+	}
+
+	// A changed source index ID invalidates any previously recorded pair.
+	f.setCovalentCompletion(f.covalentCompletionEpoch(), map[protocol.DeviceID]covalentCompletionPair{device1: completion})
+	must(t, m.sdb.SetIndexID(f.ID, device1, covalentTestRemoteIndexID+1))
+	if got := f.covalentCompletion(); len(got) != 0 {
+		t.Fatalf("old index completion remained visible: %+v", got)
+	}
+}
