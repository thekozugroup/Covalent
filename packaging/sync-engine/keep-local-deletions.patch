+func TestCovalentCompletionRunsThroughFolderPullAfterRestartWithNoNeed(t *testing.T) {
+	m, f, wcfgCancel := setupROFolderWithOptions(t, false, false, false)
+	defer wcfgCancel()
+	defer cleanupModel(m)
+	must(t, f.Filesystem().MkdirAll(".stfolder", 0o755))
+	addFakeConn(m, device1, f.ID)
+	must(t, m.sdb.SetIndexID(f.ID, device1, covalentTestRemoteIndexID))
+
+	fresh := newReceiveOnlyFolder(m.model, f.ignores, f.FolderConfiguration, nil, events.NoopLogger, f.ioLimiter).(*receiveOnlyFolder)
+	ctx := context.Background()
+	must(t, fresh.scanSubdirs(ctx, nil))
+	close(fresh.initialScanFinished)
+	need := mustV(fresh.db.CountNeed(fresh.folderID, protocol.LocalDeviceID))
+	if need.TotalItems() != 0 {
+		t.Fatalf("fresh unchanged folder has need: %+v", need)
+	}
+	complete, err := fresh.folder.pull(ctx)
+	if err != nil || !complete {
+		t.Fatalf("folder pull failed: complete=%v err=%v", complete, err)
+	}
+	if got := fresh.covalentCompletion()[device1]; got.indexID != covalentTestRemoteIndexID || got.sequence != 0 {
+		t.Fatalf("folder pull completion pair is wrong: %+v", got)
+	}
+}
