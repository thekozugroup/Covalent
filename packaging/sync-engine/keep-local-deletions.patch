+func (f *folder) clearCovalentCompletion() {
+	if f.Type != config.FolderTypeReceiveOnly {
+		return
+	}
+	f.covalentCompletionMut.Lock()
+	f.covalentEpoch++
+	f.covalentCompletions = nil
