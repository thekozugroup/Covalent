+const covalentTestRemoteIndexID = protocol.IndexID(0x1234567890ABCDEF)
+
+func TestCovalentCompletionNeedsStableRemoteIndex(t *testing.T) {
+	handler := new(indexHandler)
+	stable := map[protocol.DeviceID]covalentCompletionPair{
+		device1: {indexID: covalentTestRemoteIndexID, sequence: 7, connectionID: "primary", indexHandler: handler},
+	}
+	if !covalentCompletionPairsEqual(stable, stable) {
+		t.Fatal("equal completion pairs were rejected")
+	}
+	changedIndex := map[protocol.DeviceID]covalentCompletionPair{
+		device1: {indexID: covalentTestRemoteIndexID + 1, sequence: 7, connectionID: "primary", indexHandler: handler},
+	}
+	if covalentCompletionPairsEqual(stable, changedIndex) {
+		t.Fatal("changed remote index ID was accepted")
+	}
+	changedSequence := map[protocol.DeviceID]covalentCompletionPair{
+		device1: {indexID: covalentTestRemoteIndexID, sequence: 8, connectionID: "primary", indexHandler: handler},
+	}
+	if covalentCompletionPairsEqual(stable, changedSequence) {
+		t.Fatal("changed remote sequence was accepted")
+	}
+	changedConnection := map[protocol.DeviceID]covalentCompletionPair{
+		device1: {indexID: covalentTestRemoteIndexID, sequence: 7, connectionID: "replacement", indexHandler: handler},
+	}
+	if covalentCompletionPairsEqual(stable, changedConnection) {
+		t.Fatal("changed remote index connection was accepted")
+	}
+	changedHandler := map[protocol.DeviceID]covalentCompletionPair{
+		device1: {indexID: covalentTestRemoteIndexID, sequence: 7, connectionID: "primary", indexHandler: new(indexHandler)},
+	}
+	if covalentCompletionPairsEqual(stable, changedHandler) {
+		t.Fatal("changed remote index handler was accepted")
+	}
+}
