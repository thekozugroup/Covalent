+func (f *sendReceiveFolder) restoreLocalDeletions() error {
+	if f.Type != config.FolderTypeReceiveOnly || !f.RestoreLocalDeletions {
+		return nil
+	}
+	f.clearCovalentCompletion()
+
+	batch := NewFileInfoBatch(func(files []protocol.FileInfo) error {
+		f.updateLocalsFromScanning(files)
+		return nil
+	})
+	for local, err := range itererr.Zip(f.db.AllLocalFiles(f.folderID, protocol.LocalDeviceID)) {
+		if err != nil {
+			return err
+		}
+		if !local.IsDeleted() || !local.IsReceiveOnlyChanged() {
+			continue
+		}
+		global, ok, err := f.db.GetGlobalFile(f.folderID, local.Name)
+		if err != nil {
+			return err
+		}
+		if !ok || global.IsDeleted() || global.IsInvalid() || global.IsReceiveOnlyChanged() {
+			continue
+		}
+		local.LocalFlags &^= protocol.FlagLocalReceiveOnly
+		local.Version = protocol.Vector{}
+		batch.Append(local)
+		if err := batch.FlushIfFull(); err != nil {
+			return err
+		}
+	}
+	return batch.Flush()
+}
