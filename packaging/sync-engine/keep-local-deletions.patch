+func TestLocalDeletionOptionsOnlyReceiveOnly(t *testing.T) {
+	devices := map[protocol.DeviceID]*DeviceConfiguration{
+		device1: {DeviceID: device1},
+	}
+	for _, folderType := range []FolderType{
+		FolderTypeSendReceive,
+		FolderTypeSendOnly,
+		FolderTypeReceiveOnly,
+		FolderTypeReceiveEncrypted,
+	} {
+		folder := FolderConfiguration{
+			Type:                  folderType,
+			KeepLocalDeletions:    true,
+			RestoreLocalDeletions: true,
+		}
+		folder.prepare(device1, devices)
+
+		if got, want := folder.KeepLocalDeletions, folderType == FolderTypeReceiveOnly; got != want {
+			t.Errorf("type %v: got keepLocalDeletions=%v, want %v", folderType, got, want)
+		}
+		if folder.RestoreLocalDeletions {
+			t.Errorf("type %v: ambiguous restoreLocalDeletions remained enabled", folderType)
+		}
+	}
+
+	folder := FolderConfiguration{
+		Type:                  FolderTypeReceiveOnly,
+		RestoreLocalDeletions: true,
+	}
+	folder.prepare(device1, devices)
+	if !folder.RestoreLocalDeletions || folder.KeepLocalDeletions {
+		t.Fatalf("explicit restore-only config changed: %+v", folder)
+	}
+}
