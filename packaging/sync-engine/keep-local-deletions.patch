+func TestRecvOnlyRestoreLocalDeletionsAfterConfigChange(t *testing.T) {
+	m, f, wcfgCancel := setupROFolder(t)
+	defer wcfgCancel()
+	defer cleanupModel(m)
+	ffs := f.Filesystem()
+	must(t, ffs.MkdirAll(".stfolder", 0o755))
+	conn := addFakeConn(m, device1, f.ID)
+
+	conn.addFile("deleted", 0o644, protocol.FileInfoTypeFile, []byte("source"))
+	conn.addFile("tree", 0o755, protocol.FileInfoTypeDirectory, nil)
+	conn.addFile("tree/child", 0o644, protocol.FileInfoTypeFile, []byte("child"))
+	conn.addFile("modified", 0o644, protocol.FileInfoTypeFile, []byte("source"))
+	conn.sendIndexUpdate()
+	pullReceiveOnlyNow(t, f)
+
+	must(t, ffs.Remove("deleted"))
+	must(t, ffs.RemoveAll("tree"))
+	writeFilePerm(t, ffs, "modified", []byte("local"), 0o644)
+	must(t, m.ScanFolder(f.ID))
+
+	folderConfig, ok := m.cfg.Folder(f.ID)
+	if !ok {
+		t.Fatal("receive-only folder config is missing")
+	}
+	folderConfig.RestoreLocalDeletions = true
+	setFolder(t, m.cfg, folderConfig)
+
+	// Changing the option restarts the folder. The initial scan must schedule
+	// restoration even though the remote index has no ordinary needed items.
+	deadline := time.Now().Add(10 * time.Second)
+	for {
+		_, deletedErr := ffs.Lstat("deleted")
+		_, childErr := ffs.Lstat("tree/child")
+		if deletedErr == nil && childErr == nil {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatalf("background restoration did not complete: deleted=%v child=%v", deletedErr, childErr)
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+
+	for name, want := range map[string]string{
+		"deleted":    "source",
+		"tree/child": "child",
+		"modified":   "local",
+	} {
+		if got := string(readReceiveOnlyFile(t, ffs, name)); got != want {
+			t.Errorf("%s contains %q, want %q", name, got, want)
+		}
+	}
+}
